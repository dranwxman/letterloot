{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "letterloot.net" }],
      "destination": "/home/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.letterloot.net" }],
      "destination": "https://letterloot.net/home/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
